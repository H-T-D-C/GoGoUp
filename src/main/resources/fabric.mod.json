{
  "schemaVersion": 1,
  "id": "gogoup",
  "version": "${version}",
  "name": "GoGoUp",
  "description": "Expands the vanilla dimensions' build range with a configurable, live server-side placement ceiling.",
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.velters.gogoup.GoGoUpMod"
    ]
  },
  "mixins": [
    "gogoup.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}
